{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-fA-F]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "name",
        "uri",
        "digest",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "LOG",
        "SCREENSHOT",
        "VIDEO",
        "TRACE",
        "ALLURE",
        "OTHER"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "case_code": {
          "minLength": 1,
          "title": "Case Code",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CaseResultStatus"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "failure_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "case_code",
        "status",
        "started_at",
        "finished_at",
        "duration_ms"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "CaseResultStatus": {
      "enum": [
        "PASSED",
        "FAILED",
        "SKIPPED",
        "INFRA_ERROR"
      ],
      "title": "CaseResultStatus",
      "type": "string"
    },
    "RunExecutionIsolationEvidence": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "IN_PROCESS",
            "SUBPROCESS",
            "CONTAINER",
            "KUBERNETES"
          ],
          "title": "Mode",
          "type": "string"
        },
        "executor_version": {
          "minLength": 1,
          "title": "Executor Version",
          "type": "string"
        },
        "dedicated_process": {
          "title": "Dedicated Process",
          "type": "boolean"
        },
        "credential_scope": {
          "enum": [
            "WORKER",
            "RUN_SECRETS_ONLY"
          ],
          "title": "Credential Scope",
          "type": "string"
        },
        "workspace_scope": {
          "const": "RUN_DIRECTORY",
          "default": "RUN_DIRECTORY",
          "title": "Workspace Scope",
          "type": "string"
        },
        "read_only_root_filesystem": {
          "title": "Read Only Root Filesystem",
          "type": "boolean"
        },
        "network_policy": {
          "enum": [
            "WORKER_DEFAULT",
            "DENY_ALL",
            "ALLOWLIST"
          ],
          "title": "Network Policy",
          "type": "string"
        },
        "resource_limits_enforced": {
          "title": "Resource Limits Enforced",
          "type": "boolean"
        },
        "runtime_image_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Image Id"
        },
        "memory_limit_bytes": {
          "anyOf": [
            {
              "minimum": 134217728,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Limit Bytes"
        },
        "cpu_limit_millis": {
          "anyOf": [
            {
              "maximum": 32000,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Limit Millis"
        },
        "pids_limit": {
          "anyOf": [
            {
              "maximum": 4096,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids Limit"
        },
        "ephemeral_storage_limit_bytes": {
          "anyOf": [
            {
              "minimum": 67108864,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ephemeral Storage Limit Bytes"
        },
        "orchestrator_namespace": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orchestrator Namespace"
        },
        "service_account_name": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Account Name"
        },
        "service_account_token_automounted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Account Token Automounted"
        }
      },
      "required": [
        "mode",
        "executor_version",
        "dedicated_process",
        "credential_scope",
        "read_only_root_filesystem",
        "network_policy",
        "resource_limits_enforced"
      ],
      "title": "RunExecutionIsolationEvidence",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "QUEUED",
        "PREPARING",
        "RUNNING",
        "PASSED",
        "FAILED",
        "CANCELED",
        "TIMED_OUT",
        "INFRA_ERROR"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "runner_version": {
      "minLength": 1,
      "title": "Runner Version",
      "type": "string"
    },
    "case_results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Case Results",
      "type": "array"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "execution_isolation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunExecutionIsolationEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "status",
    "started_at",
    "finished_at",
    "runner_version",
    "case_results"
  ],
  "title": "RunResult",
  "type": "object"
}
