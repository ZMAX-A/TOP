{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-fA-F]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "name",
        "uri",
        "digest",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "LOG",
        "SCREENSHOT",
        "VIDEO",
        "TRACE",
        "ALLURE",
        "OTHER"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "case_code": {
          "minLength": 1,
          "title": "Case Code",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CaseResultStatus"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "failure_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "case_code",
        "status",
        "started_at",
        "finished_at",
        "duration_ms"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "CaseResultStatus": {
      "enum": [
        "PASSED",
        "FAILED",
        "SKIPPED",
        "INFRA_ERROR"
      ],
      "title": "CaseResultStatus",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "QUEUED",
        "PREPARING",
        "RUNNING",
        "PASSED",
        "FAILED",
        "CANCELED",
        "TIMED_OUT",
        "INFRA_ERROR"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "runner_version": {
      "minLength": 1,
      "title": "Runner Version",
      "type": "string"
    },
    "case_results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Case Results",
      "type": "array"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status",
    "started_at",
    "finished_at",
    "runner_version",
    "case_results"
  ],
  "title": "RunResult",
  "type": "object"
}
