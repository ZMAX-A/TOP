# Local development only. Do not place real test-system credentials here.
TESTOPS_ENV=development
TESTOPS_API_HOST=0.0.0.0
TESTOPS_API_PORT=8000
TESTOPS_IMAGE_TAG=0.30.0
FRONTEND_PORT=8080
# Optional when Docker Desktop is installed outside PATH; used by recovery smoke only.
TESTOPS_DOCKER_EXECUTABLE=

# Base images are pinned by digest. Override the complete reference only after revalidation.
POSTGRES_IMAGE=postgres:17-alpine@sha256:d4bb0a8c1b7bb2e29f976d099e7bfb9a5d8858cffe9e46b35cd302cd1f1f8168
REDIS_IMAGE=redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
MINIO_IMAGE=quay.io/minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
PROMETHEUS_IMAGE=prom/prometheus:v3.13.1@sha256:3c42b892cf723fa54d2f262c37a0e1f80aa8c8ddb1da7b9b0df9455a35a7f893

POSTGRES_DB=testops
POSTGRES_USER=testops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://testops:change-me-local-only@localhost:5432/testops
DATABASE_ECHO=false
AUTO_CREATE_SCHEMA=false
RUNNER_CALLBACK_TOKEN=change-me-runner-callback-token
BOOTSTRAP_ADMIN_TOKEN=change-me-one-time-bootstrap-token
SESSION_TTL_HOURS=8
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CONTROL_PLANE_URL=http://127.0.0.1:8000
OUTBOX_BATCH_SIZE=20
QUALITY_WEBHOOK_BATCH_SIZE=20
QUALITY_WEBHOOK_TIMEOUT_SECONDS=10
QUALITY_WEBHOOK_MAX_ATTEMPTS=8
QUALITY_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
QUALITY_ALERT_POLL_SECONDS=5
QUALITY_ALERT_EVALUATION_INTERVAL_SECONDS=60
QUALITY_ALERT_BATCH_SIZE=50
RUNNER_WORKSPACE_ROOT=artifacts/runs

MINIO_ROOT_USER=testops-local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=testops-artifacts
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=testops-local
MINIO_SECRET_KEY=change-me-local-only
ARTIFACT_URL_TTL_SECONDS=300
RUN_EVENT_POLL_SECONDS=0.5
RUN_EVENT_HEARTBEAT_SECONDS=15
RUNNER_HEARTBEAT_TTL_SECONDS=45
RUN_DISPATCH_START_TIMEOUT_SECONDS=300
SUPPLY_CHAIN_POLICY_VERSION=testops-supply-chain-v1
SUPPLY_CHAIN_ALLOWED_VERIFIERS=ci-cosign-slsa-verifier
SUPPLY_CHAIN_ALLOWED_CERTIFICATE_ISSUERS=https://token.actions.githubusercontent.com
SUPPLY_CHAIN_ALLOWED_CERTIFICATE_IDENTITIES=https://github.com/example/testops/.github/workflows/release.yml
SUPPLY_CHAIN_ALLOWED_BUILDER_IDS=https://github.com/actions/runner
SUPPLY_CHAIN_ALLOWED_SOURCE_REPOSITORIES=https://github.com/example/testops
# Public example key from RFC 8032; replace it with the verifier workload's own key.
SUPPLY_CHAIN_VERIFIER_ED25519_KEYS=[{"credential_id":"ci-cosign-slsa-verifier/2026-08-ed25519","workload_identity":"https://github.com/example/testops/.github/workflows/release.yml","public_key":"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo"}]
# Temporary migration only. Keep disabled after CI switches to Ed25519.
SUPPLY_CHAIN_ALLOW_LEGACY_HMAC=false
SUPPLY_CHAIN_VERIFIER_HMAC_KEYS=
SUPPLY_CHAIN_ENVELOPE_TTL_SECONDS=300
SUPPLY_CHAIN_ENVELOPE_FUTURE_SKEW_SECONDS=30
RUNNER_CAPACITY_POLL_SECONDS=2
RUNNER_WORKER_KEY=compose-web-1
RUNNER_POOL_KEY=default-web
RUNNER_DISPLAY_NAME=Compose Web Worker 1
RUNNER_VERSION=0.30.0
RUNNER_MAX_SLOTS=1
RUNNER_HEARTBEAT_INTERVAL_SECONDS=15
RUNNER_CAPABILITIES={"target_types":["WEB"],"browsers":["chromium"],"labels":{"runtime":"compose","os":"linux"}}
RUNNER_PACKAGE_CATALOG=[{"runner_type":"WEB_PLAYWRIGHT","image_repository":"testops-worker","digest":"sha256:e040482d91882b9be417b94cd0c404c072b7988bd61a04bb6d82da1f0b68f5e7"}]
RUNNER_EXECUTION_MODE=CONTAINER
RUNNER_EXECUTOR_POLL_SECONDS=2
RUNNER_EXECUTOR_TIMEOUT_SECONDS=3600
RUNNER_CONTAINER_IMAGE=testops-worker:0.30.0
RUNNER_CONTAINER_NETWORK_POLICY=ALLOWLIST
RUNNER_CONTAINER_NETWORK=testops-runner-sandbox
RUNNER_CONTAINER_MEMORY_MIB=1024
RUNNER_CONTAINER_CPU_MILLIS=1000
RUNNER_CONTAINER_PIDS_LIMIT=256
RUNNER_CONTAINER_SHM_MIB=512
# Kubernetes mode is for a dedicated controller deployment, not the local Compose Worker.
# The operator attestation must only be true when the cluster CNI enforces NetworkPolicy.
RUNNER_KUBERNETES_NAMESPACE=testops-runs
RUNNER_KUBERNETES_SERVICE_ACCOUNT=testops-runner
RUNNER_KUBERNETES_NETWORK_POLICY=DENY_ALL
RUNNER_KUBERNETES_NETWORK_POLICY_ENFORCED=false
RUNNER_KUBERNETES_ALLOW_CIDRS=
RUNNER_KUBERNETES_MEMORY_MIB=1024
RUNNER_KUBERNETES_CPU_MILLIS=1000
RUNNER_KUBERNETES_EPHEMERAL_STORAGE_MIB=2048
RUNNER_KUBERNETES_CLEANUP_TTL_SECONDS=300
RUNNER_KUBERNETES_IN_CLUSTER=true
RUNNER_KUBERNETES_CONTEXT=
# Linux Docker hosts may need the numeric group owning /var/run/docker.sock.
DOCKER_SOCKET_GID=0
SCHEDULER_POLL_SECONDS=5
SCHEDULER_BATCH_SIZE=50
RUN_REAPER_POLL_SECONDS=15
RUN_REAPER_BATCH_SIZE=100
# Optional for direct API scrapes. Leave empty only on a trusted internal network.
METRICS_TOKEN=
PROMETHEUS_PORT=9090

# Deterministic local Compose smoke target. Its credentials are fixed non-secret QA values.
SMOKE_TARGET_PORT=18080
TESTOPS_SMOKE_BASE_URL=http://127.0.0.1:8080
TESTOPS_SMOKE_TARGET_HEALTH_URL=http://127.0.0.1:18080/healthz
TESTOPS_SMOKE_ADMIN_USERNAME=smoke-admin
TESTOPS_SMOKE_ADMIN_PASSWORD=testops-smoke-admin-password
